# ---------------------------------------------------------------------------
# LisBee environment
#
# Everything here is optional in development: with no variables set the app runs
# on the local file store (.data/db.json) and writes emails to .data/outbox.
# Set the values below for production.
# ---------------------------------------------------------------------------

# Public site URL — used for canonical links, sitemaps and email links.
NEXT_PUBLIC_SITE_URL=https://hellolisbee.com

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Shared code required to sign in to a STAFF (admin) account.
# Email sign-in has no password, so without this anyone could type an admin's
# address and take over the shop. In production this is MANDATORY: if it is not
# set, nobody can get into the admin area at all. Locally it is optional.
ADMIN_ACCESS_CODE=

# --- Supabase (database + Google OAuth) -------------------------------------
# The anon key is public and safe in the browser. The service-role key is
# server-only: never prefix it with NEXT_PUBLIC_ and never commit it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth: in Supabase → Authentication → Providers → Google, set the
# authorised redirect URI to:
#   <NEXT_PUBLIC_SUPABASE_URL>/auth/v1/callback

# --- Mailgun (transactional email) -----------------------------------------
# Without these, emails are written to .data/outbox and logged in the admin area.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# --- Paystack (card payments) ----------------------------------------------
# Leave unset at launch: checkout uses bank transfer. Card payments are also
# gated by the "paystack enabled" switch in Admin → Settings.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Set to 1 only when serving over plain HTTP locally (lets cookies be insecure).
# INSECURE_HTTP=
